# Образец настроек: скопируйте в .env и задайте секрет.
# Секрет подписи сессий, не короче 32 символов: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Адрес, с которого пользователи открывают Ferrum: из него строятся ссылки в письмах и trustedOrigins.
PUBLIC_URL=http://localhost:8090
# Порт сервера снаружи контейнера. Поменяли порт — поменяйте и PUBLIC_URL: браузер пришлёт его в Origin.
FERRUM_PORT=8090
# Интерфейс, на котором открыт порт. По умолчанию только эта машина; прямой доступ снаружи: 0.0.0.0.
FERRUM_BIND=127.0.0.1
# Пароль Postgres; DATABASE_URL внутри сети compose собирается из него.
POSTGRES_PASSWORD=ferrum
# Почта. По умолчанию письма перехватывает Mailpit (http://localhost:8025, профиль dev). Порт открыт
# только на 127.0.0.1: в письмах ссылки входа, а у веб-интерфейса Mailpit нет пароля.
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=Ferrum <ferrum@localhost>
# Профили compose: `dev` включает Mailpit. На рабочем сервере уберите и задайте настоящий SMTP_URL.
COMPOSE_PROFILES=dev
# Кто может войти: адреса и домены через запятую (ivan@example.com,example.org). Пусто — любой.
ALLOWED_EMAILS=
# Адреса обратных прокси через запятую, точные и IPv4 CIDR (10.0.0.1,172.16.0.0/12): только от них
# сервер верит X-Forwarded-For. Пусто — заголовку не верим. Подробнее: docs/running.md.
TRUSTED_PROXIES=
